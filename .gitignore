# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
*.spec

# Virtual environment
.venv/

# Tooling caches
.ruff_cache/

# Editor / AI tool config — keep the portable, team-useful bits tracked
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.claude/

# OS junk
.DS_Store

# MSVC build artifacts (native/*/*.exe are committed on purpose)
native/**/*.obj
native/**/*.pdb
native/**/*.ilk

# Local planning/notes — not published
plan.md

# Local secrets — never committed
.env

# Installer build output
installer/Output/
