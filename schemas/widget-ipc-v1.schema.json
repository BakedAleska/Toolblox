{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolblox.dev/schemas/widget-ipc-v1.schema.json",
  "title": "Toolblox widget IPC request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestId", "method"],
  "properties": {
    "protocol": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "method": {
      "enum": [
        "accounts.list",
        "widgetData.get",
        "widgetData.set",
        "roblox.status",
        "roblox.join",
        "network.fetch",
        "process.spawn",
        "process.send",
        "process.poll",
        "process.stop"
      ]
    },
    "params": {}
  }
}
