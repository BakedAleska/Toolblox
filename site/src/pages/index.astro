---
import Site from "../layouts/Site.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { ArrowRight, ChevronDown, CircleHelp, Download, Eye, Hammer, HardDrive, Laptop, Monitor, Puzzle, ShieldCheck } from "lucide-react";

const repo = "https://github.com/BakedAleska/Toolblox";
const installer = `${repo}/releases/latest/download/Toolblox-Setup.exe`;
const macInstaller = `${repo}/releases/latest/download/Toolblox.dmg`;

/** The core commitments from `PRODUCT.md`, each linked to the evidence for it. */
const commitments = [
  { icon: Eye, title: "Free and open source", text: "No ads or paid features. Every line of source code is public under the MIT License, and every release is built from it in the open.", link: { label: "Source code", href: repo } },
  { icon: ShieldCheck, title: "No injection", text: "Toolblox never injects code into Roblox, reads or changes its memory, or provides exploits or cheats. It signs in through Roblox's own page and launches Roblox the same way the Roblox website does.", link: { label: "Launch code", href: `${repo}/blob/main/src-tauri/src/roblox.rs` } },
  { icon: HardDrive, title: "Data stays on your device", text: "Accounts and settings are stored on your computer and logins in its secure storage: {storage}. There's no Toolblox server or telemetry, and Toolblox connects only to Roblox and GitHub.", link: { label: "Every connection", href: "/legal/#network-connections" } },
];

const questions = [
  { question: "Is Toolblox free?", answer: "Yes. Toolblox is free, with no advertisements or paid features, and is released under the MIT License." },
  { question: "Can Toolblox see my password?", answer: "No. Accounts are added through Roblox's own sign-in page. Toolblox stores only the login token Roblox provides, keeps it in your computer's secure storage, and never sends it anywhere other than Roblox." },
  { question: "Does Toolblox inject into Roblox?", answer: "No. Toolblox never injects code into Roblox, reads or changes its memory, or provides exploits, cheats, or any in-game advantage. It launches Roblox the same way the Roblox website does, so it shouldn't break any Roblox rules and is safe to use. Roblox decides how its Terms of Use are enforced, so no outside app can promise how they'll be applied. Widgets are reviewed before they're listed and can never inject code into Roblox or provide exploits or cheats. A widget can use permissions Toolblox itself doesn't, such as contacting approved websites, and the app lists each widget's permissions before it's installed." },
  { question: "Does my data leave my computer?", answer: "Not to Toolblox. There's no Toolblox server, account service, or telemetry. The app connects only to Roblox, to sign in and join games, and to GitHub, to check for updates and widgets. The privacy policy lists every connection, and the source code shows them." },
  { os: "windows", question: "Why does Windows show a warning?", answer: "Windows shows this warning for applications from publishers it doesn't recognize yet, and Toolblox doesn't currently have a paid code-signing certificate. Select More info, then Run anyway, but only for a file downloaded from this site or the official GitHub page." },
  { question: "Is Toolblox made by Roblox?", answer: "No. Toolblox is an independent project and isn't affiliated with or endorsed by Roblox Corporation." },
  { os: "mac", question: "Why does macOS say it can't verify Toolblox?", answer: "macOS shows this for apps that aren't notarized by Apple, and Toolblox doesn't currently have a paid Apple Developer ID. Select Done, then open System Settings, Privacy & Security, and select Open Anyway, but only for a file downloaded from this site or the official GitHub page." },
  { question: "Is a macOS version available?", answer: "Yes. Toolblox runs on Apple silicon and Intel Macs with the same features as on Windows, including multiple Roblox instances. Download the universal macOS app below." },
];

/** Hides a question from visitors on the other operating system. */
const questionClass = { windows: "mac:hidden", mac: "windows:hidden" } as const;

/** Hero titles, typed in order. The first is the static title. */
const titles = ["Toolblox, your new best friend.", "Sign in once. That's it.", "Your logins. Your device.", "No ads, no catch, no key.", "It just stays out of the way."];
---

<Site>
      <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 pt-16 pb-12 text-center sm:pt-24">
        <h1 class="rise grid max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
          <span class="sr-only">{titles[0]}</span>
          {titles.map((title) => <span aria-hidden="true" class="invisible col-start-1 row-start-1">{title}</span>)}
          <span aria-hidden="true" class="col-start-1 row-start-1"><span data-typed data-titles={JSON.stringify(titles)}>{titles[0]}</span><span data-caret class="caret ml-[0.04em] inline-block h-[0.9em] w-[0.06em] min-w-[2px] bg-foreground align-[-0.1em]"></span></span>
        </h1>
        <p class="rise max-w-2xl text-lg text-pretty text-muted-foreground" style="--i: 1">
          A free desktop app for managing Roblox accounts. Run several at once, tune how each one launches, and add widgets for the games you play as they're released.
        </p>
        <div class="rise grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2" style="--i: 2">
          <span class="contents mac:hidden"><a href={installer} class={buttonVariants({ size: "lg", className: "h-10 w-full px-4" })}><Download />Download for Windows</a></span>
          <span class="hidden mac:contents"><a href={macInstaller} data-mac-hero class={buttonVariants({ size: "lg", className: "h-10 w-full px-4" })}><Download />Download for macOS</a></span>
          <a href={repo} class={buttonVariants({ size: "lg", variant: "outline", className: "h-10 w-full px-4" })}><GitHubIcon />View source code</a>
        </div>
        <ul class="rise flex justify-center gap-3" style="--i: 3" aria-label="Commitments">
          {commitments.map(({ icon: Icon, title }) => (
            <li><a href="#commitments" aria-label={title} title={title} class="flex size-9 items-center justify-center rounded-lg text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50"><Icon className="size-5" aria-hidden="true" /></a></li>
          ))}
        </ul>
        <p class="rise text-sm text-muted-foreground" style="--i: 3">
          Free for Windows and macOS<span data-release-version hidden></span>
        </p>
        <div class="rise mt-6 w-full" style="--i: 4">
          <div data-preview-box class="h-[560px] overflow-hidden rounded-xl bg-background ring-1 ring-border">
            <iframe data-preview src="/preview/index.html?showcase" title="Toolblox, running on sample accounts" class="h-[560px] w-full origin-top-left"></iframe>
          </div>
          <p class="mt-3 text-sm text-muted-foreground">Interactive preview with sample accounts. Nothing here connects to Roblox.</p>
        </div>
      </section>

      <section id="commitments" class="scroll-mt-14 border-t bg-muted/40">
        <div class="mx-auto flex max-w-5xl flex-col gap-12 px-4 py-24">
          <div class="mx-auto flex max-w-2xl flex-col gap-4 text-center">
            <p class="flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground"><GitHubIcon />Commitments</p>
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">Transparent by design.</h2>
            <p class="text-lg text-pretty text-muted-foreground">
              An account manager holds your Roblox logins, so its promises should be easy to check. Each one below links to the code or policy behind it.
            </p>
          </div>
          <ul class="grid gap-4 md:grid-cols-3">
            {commitments.map(({ icon: Icon, title, text, link }) => (
              <li class="flex flex-col gap-3 rounded-xl bg-card p-6 ring-1 ring-border">
                <span class="flex size-9 items-center justify-center rounded-lg bg-muted"><Icon className="size-4" /></span>
                <h3 class="font-medium">{title}</h3>
                <p class="text-sm text-muted-foreground">
                  {text.split("{storage}").map((part, index) => (
                    <Fragment>
                      {index > 0 && (
                        <Fragment><span class="hidden windows:inline">Windows Credential Manager</span><span class="hidden mac:inline">the macOS Keychain</span><span class="hidden other:inline">Windows Credential Manager or the macOS Keychain</span></Fragment>
                      )}
                      {part}
                    </Fragment>
                  ))}
                </p>
                <a href={link.href} class="mt-auto inline-flex items-center gap-1 text-sm underline-offset-4 hover:underline">{link.label}<ArrowRight className="size-3.5" /></a>
              </li>
            ))}
          </ul>
          <details class="group rounded-xl bg-card ring-1 ring-border">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium outline-none focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
              <Hammer className="size-4" />Build Toolblox yourself or verify a download
              <span class="ml-auto text-xs font-normal text-muted-foreground">For developers</span>
              <ChevronDown className="size-4 transition-transform group-open:rotate-180" />
            </summary>
            <div class="grid gap-4 border-t p-4 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium">Build from source</p>
                <pre class="overflow-x-auto rounded-lg bg-muted p-3 font-mono text-sm leading-6"><code><span class="text-muted-foreground select-none">$ </span>git clone {repo}
<span class="text-muted-foreground select-none">$ </span>cd Toolblox
<span class="text-muted-foreground select-none">$ </span>npm install
<span class="text-muted-foreground select-none">$ </span>npm run tauri dev</code></pre>
                <p class="text-xs text-muted-foreground">Needs Node.js 22, Rust, and the <a href="https://tauri.app/start/prerequisites/" class="underline underline-offset-4">Tauri prerequisites</a>.</p>
              </div>
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium">Verify a download</p>
                <pre class="overflow-x-auto rounded-lg bg-muted p-3 font-mono text-sm leading-6"><code><span class="mac:hidden"><span class="text-muted-foreground select-none">PS&gt; </span>Get-FileHash .\Toolblox-Setup.exe
</span><span class="windows:hidden"><span class="text-muted-foreground select-none">$ </span>shasum -a 256 Toolblox.dmg</span></code></pre>
                <p class="text-xs text-muted-foreground">Compare the result with the SHA-256 on the <a href={`${repo}/releases`} class="underline underline-offset-4">release page</a>.</p>
                <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 text-xs">
                  <a href={`${repo}/blob/main/src-tauri/src/credentials.rs`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Login storage code<ArrowRight className="size-3" /></a>
                  <a href={`${repo}/blob/main/.github/workflows/release.yml`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Release workflow<ArrowRight className="size-3" /></a>
                  <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Contributing guide<ArrowRight className="size-3" /></a>
                </div>
              </div>
            </div>
          </details>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <a href="/legal/" class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Terms, privacy policy, security policy, and license<ArrowRight className="size-3.5" /></a>
          </div>
        </div>
      </section>

      <section id="widgets" class="scroll-mt-14 border-t">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-4 py-24 text-center">
          <p class="flex items-center gap-2 text-sm font-medium text-muted-foreground"><Puzzle className="size-4" />Widgets</p>
          <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Extensible with widgets.</h2>
          <p class="text-pretty text-muted-foreground">
            Widgets will add tools for individual games. Each one is reviewed and signed before it's listed in the app. None are available yet, and developers can start with the widget documentation.
          </p>
          <a href="/docs/" class={buttonVariants({ variant: "outline" })}>Widget documentation<ArrowRight /></a>
        </div>
      </section>

      <section id="faq" class="scroll-mt-14 border-t bg-muted/40">
        <div class="mx-auto flex max-w-3xl flex-col gap-12 px-4 py-24">
          <div class="flex flex-col gap-4 text-center">
            <p class="flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground"><CircleHelp className="size-4" />Support</p>
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Frequently asked questions</h2>
          </div>
          <div class="divide-y rounded-xl bg-card ring-1 ring-border">
            {questions.map(({ os, question, answer }) => (
              <details class:list={["group", os && questionClass[os]]}>
                <summary class="flex cursor-pointer list-none items-center gap-4 px-4 py-4 font-medium outline-none focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
                  {question}
                  <ChevronDown className="ml-auto size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
                </summary>
                <p class="px-4 pb-4 text-pretty text-muted-foreground">{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="download" class="scroll-mt-14 border-t">
        <div class="mx-auto flex max-w-5xl flex-col gap-12 px-4 py-24">
          <div class="mx-auto flex max-w-2xl flex-col gap-4 text-center">
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Download Toolblox</h2>
            <p data-downloads hidden class="flex items-center justify-center gap-3 text-5xl font-semibold tracking-tight tabular-nums">
              <Download className="size-10" aria-hidden="true" /><span data-downloads-count></span><span data-downloads-label class="sr-only"></span>
            </p>
          </div>
          <p class="hidden text-center text-sm text-muted-foreground other:block">Toolblox runs on Windows 10 and 11 and on Macs. Open this page on one of them to download it.</p>
          <div data-download-cards class="mx-auto grid w-full max-w-md gap-4 other:max-w-none other:opacity-50 md:other:grid-cols-2">
            <Card className="mac:hidden">
              <CardHeader>
                <Monitor className="mb-2 size-6" />
                <CardTitle>Windows</CardTitle>
                <CardDescription>For Windows 10 and 11<span data-release-version hidden></span></CardDescription>
              </CardHeader>
              <CardContent>
                <a href="/docs/install/" data-install-tab="Windows" class="group block rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
                  <ol class="flex max-h-16 list-decimal flex-col gap-1 overflow-hidden pl-5 text-sm text-muted-foreground mask-b-from-10%">
                  <li>Open <strong class="font-medium text-foreground">Toolblox-Setup.exe</strong> once the download completes.</li>
                  <li>If Windows shows “Windows protected your PC”, select <strong class="font-medium text-foreground">More info</strong>, then <strong class="font-medium text-foreground">Run anyway</strong>.</li>
                  <li>Complete the setup. Toolblox updates automatically from then on.</li>
                  </ol>
                  <span class="mt-1 inline-flex items-center gap-1 text-sm underline-offset-4 group-hover:underline">More download instructions<ArrowRight className="size-3.5" /></span>
                </a>
              </CardContent>
              <CardFooter className="mt-auto">
                <a href={installer} class={buttonVariants({ className: "w-full" })}><Download />Download for Windows</a>
              </CardFooter>
            </Card>
            <Card className="windows:hidden">
              <CardHeader>
                <Laptop className="mb-2 size-6" />
                <CardTitle>macOS</CardTitle>
                <CardDescription>For Apple silicon and Intel Macs<span data-mac-release-version hidden></span></CardDescription>
              </CardHeader>
              <CardContent>
                <a href="/docs/install/" data-install-tab="macOS" class="group block rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
                  <ol class="flex max-h-16 list-decimal flex-col gap-1 overflow-hidden pl-5 text-sm text-muted-foreground mask-b-from-10%">
                  <li>Open <strong class="font-medium text-foreground">Toolblox.dmg</strong> and drag Toolblox to Applications.</li>
                  <li>If macOS says it can't verify the developer, select <strong class="font-medium text-foreground">Done</strong>, then <strong class="font-medium text-foreground">Open Anyway</strong> in System Settings → Privacy &amp; Security.</li>
                  <li>Toolblox updates automatically from then on.</li>
                  </ol>
                  <span class="mt-1 inline-flex items-center gap-1 text-sm underline-offset-4 group-hover:underline">More download instructions<ArrowRight className="size-3.5" /></span>
                </a>
              </CardContent>
              <CardFooter className="mt-auto">
                <a href={macInstaller} data-mac-download data-href={macInstaller} data-ready-class={buttonVariants({ className: "w-full" })} class={buttonVariants({ className: "w-full" })}><Download /><span data-mac-download-label>Download for macOS</span></a>
              </CardFooter>
            </Card>
          </div>
          <p class="text-center text-sm text-pretty text-muted-foreground">
            Download Toolblox only from this site or its official GitHub page.{" "}
            <a href="/docs/install/" class="underline underline-offset-4">Install guide</a> ·{" "}
            <a href="/docs/install/#verify-a-download" class="underline underline-offset-4">How to verify a download</a>
          </p>
        </div>
      </section>
  <script>
      /* The install guide opens on the tab for the card's platform. Starlight keeps synced tabs in this key. */
      for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-install-tab]")) {
        link.addEventListener("click", () => {
          try { localStorage.setItem("starlight-synced-tabs__os", link.dataset.installTab ?? ""); } catch {}
        });
      }
      if (document.documentElement.dataset.os === "other") document.querySelector("[data-download-cards]")?.setAttribute("inert", "");
      fetch("https://api.github.com/repos/BakedAleska/Toolblox/releases?per_page=100")
        .then((response) => (response.ok ? response.json() : Promise.reject()))
        .then((releases: { tag_name: string; draft: boolean; assets: { name: string; download_count: number }[] }[]) => {
          const latest = releases.find((release) => !release.draft);
          if (latest) {
            const version = ` · Version ${latest.tag_name.replace(/^v/, "").replace("-", " ")}`;
            for (const element of document.querySelectorAll<HTMLElement>("[data-release-version]")) {
              element.textContent = version;
              element.hidden = false;
            }
            if (latest.assets.some((asset) => asset.name === "Toolblox.dmg")) {
              const link = document.querySelector<HTMLAnchorElement>("[data-mac-download]");
              const label = document.querySelector<HTMLElement>("[data-mac-download-label]");
              const macVersion = document.querySelector<HTMLElement>("[data-mac-release-version]");
              if (link?.dataset.href && label) {
                link.href = link.dataset.href;
                link.className = link.dataset.readyClass ?? link.className;
                label.textContent = "Download for macOS";
              }
              if (macVersion) {
                macVersion.textContent = version;
                macVersion.hidden = false;
              }
              const macHero = document.querySelector<HTMLAnchorElement>("[data-mac-hero]");
              if (macHero && link?.dataset.href) macHero.href = link.dataset.href;
            }
          }
          const total = releases
            .flatMap((release) => {
              const separateUpdater = release.assets.some((asset) => asset.name === "Toolblox-Update.exe");
              return release.assets.filter((asset) => asset.name === "Toolblox.dmg" || (separateUpdater && asset.name === "Toolblox-Setup.exe"));
            })
            .reduce((sum, asset) => sum + asset.download_count, 0);
          const element = document.querySelector<HTMLElement>("[data-downloads]");
          const count = document.querySelector<HTMLElement>("[data-downloads-count]");
          const label = document.querySelector<HTMLElement>("[data-downloads-label]");
          if (!total || !element || !count || !label) return;
          count.textContent = total.toLocaleString("en-US");
          label.textContent = ` ${total === 1 ? "download" : "downloads"}`;
          element.hidden = false;
        })
        .catch(() => {});
  </script>

  <script>
    /* The hero title types and erases each ending in turn, unless reduced motion is preferred. */
    const typed = document.querySelector<HTMLElement>("[data-typed]");
    const caret = document.querySelector<HTMLElement>("[data-caret]");
    const titles: string[] = JSON.parse(typed?.dataset.titles ?? "[]");
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const cycleTitles = async () => {
      if (!typed || !caret) return;
      for (let index = 1; ; index = (index + 1) % titles.length) {
        await wait(2600);
        caret.dataset.active = "";
        while (typed.textContent) {
          typed.textContent = typed.textContent.slice(0, -1);
          await wait(28);
        }
        await wait(350);
        for (const character of titles[index]) {
          typed.textContent += character;
          await wait(character === "." ? 500 : 55 + Math.random() * 45);
        }
        delete caret.dataset.active;
      }
    };
    if (titles.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) cycleTitles();
  </script>

  <script>
    /* The preview follows this page's color scheme while its own theme mode is System. */
    const preview = document.querySelector<HTMLIFrameElement>("iframe[data-preview]");
    const sendScheme = () => preview?.contentWindow?.postMessage({ type: "toolblox:scheme", dark: document.documentElement.classList.contains("dark") }, location.origin);
    window.addEventListener("message", (event) => {
      if (event.source === preview?.contentWindow && event.origin === location.origin && event.data?.type === "toolblox:ready") sendScheme();
    });
    document.addEventListener("toolblox:scheme", sendScheme);

    /* Narrow screens show the preview at 720 pixels wide, scaled down to fit. */
    const previewBox = document.querySelector<HTMLElement>("[data-preview-box]");
    const fitPreview = () => {
      if (!preview || !previewBox) return;
      const scale = Math.min(1, previewBox.clientWidth / 720);
      preview.style.width = `${previewBox.clientWidth / scale}px`;
      preview.style.transform = scale < 1 ? `scale(${scale})` : "";
      previewBox.style.height = `${560 * scale}px`;
    };
    if (previewBox) new ResizeObserver(fitPreview).observe(previewBox);
  </script>
</Site>
