---
import Site from "../layouts/Site.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import Screenshot from "../components/Screenshot.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { ArrowRight, ChevronDown, CircleHelp, Download, Eye, Hammer, HardDrive, Laptop, Monitor, Puzzle, ShieldCheck } from "lucide-react";

const repo = "https://github.com/BakedAleska/Toolblox";
const installer = `${repo}/releases/latest/download/Toolblox-Setup.exe`;
const macInstaller = `${repo}/releases/latest/download/Toolblox.dmg`;

/** The core commitments from `PRODUCT.md`, each linked to the evidence for it. */
const commitments = [
  { icon: Eye, title: "Free and open source", text: "No ads or paid features. Every line of source code is public under the MIT License, and every release is built from it in the open.", link: { label: "Source code", href: repo } },
  { icon: ShieldCheck, title: "No injection", text: "Toolblox never injects code into Roblox or reads or changes its memory or files. It signs in through Roblox's own page and launches Roblox the same way the Roblox website does.", link: { label: "Launch code", href: `${repo}/blob/main/src-tauri/src/roblox.rs` } },
  { icon: HardDrive, title: "Data stays on your device", text: "Accounts and settings are stored on your computer and logins in its secure storage: Windows Credential Manager or the macOS Keychain. There's no Toolblox server or telemetry, and Toolblox connects only to Roblox and GitHub.", link: { label: "Every connection", href: "/privacy/#network-connections" } },
];

const questions = [
  { question: "Is Toolblox free?", answer: "Yes. Toolblox is free, with no advertisements or paid features, and is released under the MIT License." },
  { question: "Can Toolblox see my password?", answer: "No. Accounts are added through Roblox's own sign-in page. Toolblox stores only the login token Roblox provides, keeps it in your computer's secure storage, and never sends it anywhere other than Roblox." },
  { question: "Does Toolblox inject into Roblox?", answer: "No. Toolblox never injects code into Roblox, reads or changes its memory or files, or provides any in-game advantage. It launches Roblox the same way the Roblox website does. Roblox decides how its Terms of Use apply to third-party apps, so no outside app can guarantee an account's standing." },
  { question: "Does my data leave my computer?", answer: "Not to Toolblox. There's no Toolblox server, account service, or telemetry. The app connects only to Roblox, to sign in and join games, and to GitHub, to check for updates and widgets. The privacy policy lists every connection, and the source code shows them." },
  { question: "Why does Windows show a warning?", answer: "Windows shows this warning for applications from publishers it doesn't recognize yet, and Toolblox doesn't currently have a paid code-signing certificate. Select More info, then Run anyway, but only for a file downloaded from this site or the official GitHub page." },
  { question: "Is Toolblox made by Roblox?", answer: "No. Toolblox is an independent project and isn't affiliated with or endorsed by Roblox Corporation." },
  { question: "Why does macOS say it can't verify Toolblox?", answer: "macOS shows this for apps that aren't notarized by Apple, and Toolblox doesn't currently have a paid Apple Developer ID. Select Done, then open System Settings, Privacy & Security, and select Open Anyway, but only for a file downloaded from this site or the official GitHub page." },
  { question: "Is a macOS version available?", answer: "Yes. Toolblox runs on Apple silicon and Intel Macs with the same features as on Windows, including multiple Roblox instances. The first macOS download is published with the next release." },
];
---

<Site>
      <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 pt-16 pb-12 text-center sm:pt-24">
        <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">The open-source Roblox account manager.</h1>
        <p class="max-w-2xl text-lg text-pretty text-muted-foreground">
          Manage and launch all of your Roblox accounts from one desktop app. Every line of code is public, so anyone can verify how Toolblox handles account data.
        </p>
        <ul class="flex flex-wrap justify-center gap-2" aria-label="Commitments">
          {commitments.map(({ icon: Icon, title }) => (
            <li><a href="#commitments"><Badge variant="secondary"><Icon />{title}</Badge></a></li>
          ))}
        </ul>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={installer} data-hero-download class={buttonVariants({ size: "lg", className: "h-10 px-4" })}><Download /><span data-hero-download-label>Download for Windows</span></a>
          <a href={repo} class={buttonVariants({ size: "lg", variant: "outline", className: "h-10 px-4" })}><GitHubIcon />View source code</a>
        </div>
        <p class="text-sm text-muted-foreground">
          Free for Windows and macOS<span data-release-version hidden></span>
        </p>
        <div data-downloads hidden class="flex flex-col items-center">
          <span data-downloads-count class="text-4xl font-semibold tracking-tight tabular-nums"></span>
          <span class="text-sm text-muted-foreground">downloads, not counting updates</span>
        </div>
        <div class="mt-6 w-full">
          <Screenshot name="dashboard" alt="The Toolblox home screen showing the last account played, account counts, and recently played accounts." eager />
        </div>
      </section>

      <section id="commitments" class="scroll-mt-14 border-t bg-muted/40">
        <div class="mx-auto flex max-w-5xl flex-col gap-12 px-4 py-24">
          <div class="mx-auto flex max-w-2xl flex-col gap-4 text-center">
            <p class="flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground"><GitHubIcon />Commitments</p>
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">Verifiable by design.</h2>
            <p class="text-lg text-pretty text-muted-foreground">
              An account manager handles Roblox logins, so its promises should be checkable. Each one below links to the code or policy that shows it.
            </p>
          </div>
          <ul class="grid gap-4 md:grid-cols-3">
            {commitments.map(({ icon: Icon, title, text, link }) => (
              <li class="flex flex-col gap-3 rounded-xl bg-card p-6 ring-1 ring-border">
                <span class="flex size-9 items-center justify-center rounded-lg bg-muted"><Icon className="size-4" /></span>
                <h3 class="font-medium">{title}</h3>
                <p class="text-sm text-muted-foreground">{text}</p>
                <a href={link.href} class="mt-auto inline-flex items-center gap-1 text-sm underline-offset-4 hover:underline">{link.label}<ArrowRight className="size-3.5" /></a>
              </li>
            ))}
          </ul>
          <details class="group rounded-xl bg-card ring-1 ring-border">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium outline-none focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
              <Hammer className="size-4" />For developers: build from source or verify a download
              <ChevronDown className="ml-auto size-4 transition-transform group-open:rotate-180" />
            </summary>
            <div class="grid gap-4 border-t p-4 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium">Build from source</p>
                <pre class="overflow-x-auto rounded-lg bg-muted p-3 font-mono text-sm leading-6"><code><span class="text-muted-foreground select-none">$ </span>git clone {repo}
<span class="text-muted-foreground select-none">$ </span>cd Toolblox
<span class="text-muted-foreground select-none">$ </span>npm install
<span class="text-muted-foreground select-none">$ </span>npm run tauri dev</code></pre>
                <p class="text-xs text-muted-foreground">Needs Node.js 22, Rust, and the <a href="https://tauri.app/start/prerequisites/" class="underline underline-offset-4">Tauri prerequisites</a>.</p>
              </div>
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium">Verify a download</p>
                <pre class="overflow-x-auto rounded-lg bg-muted p-3 font-mono text-sm leading-6"><code><span class="text-muted-foreground select-none">PS&gt; </span>Get-FileHash .\Toolblox-Setup.exe
<span class="text-muted-foreground select-none">$ </span>shasum -a 256 Toolblox.dmg</code></pre>
                <p class="text-xs text-muted-foreground">Compare the result with the SHA-256 on the <a href={`${repo}/releases`} class="underline underline-offset-4">release page</a>.</p>
                <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 text-xs">
                  <a href={`${repo}/blob/main/src-tauri/src/credentials.rs`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Login storage code<ArrowRight className="size-3" /></a>
                  <a href={`${repo}/blob/main/.github/workflows/release.yml`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Release workflow<ArrowRight className="size-3" /></a>
                  <a href={`${repo}/blob/main/CONTRIBUTING.md`} class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Contributing guide<ArrowRight className="size-3" /></a>
                </div>
              </div>
            </div>
          </details>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <a href="/privacy/" class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Privacy policy<ArrowRight className="size-3.5" /></a>
            <a href="/security/" class="inline-flex items-center gap-1 underline-offset-4 hover:underline">Security policy<ArrowRight className="size-3.5" /></a>
          </div>
        </div>
      </section>

      <section id="widgets" class="scroll-mt-14 border-t">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-4 py-24 text-center">
          <p class="flex items-center gap-2 text-sm font-medium text-muted-foreground"><Puzzle className="size-4" />Widgets</p>
          <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Extensible with widgets.</h2>
          <p class="text-pretty text-muted-foreground">
            Widgets will add tools for specific games through a reviewed, signed catalogue. None are published yet, and the developer documentation explains how to build one.
          </p>
          <a href="/docs/" class={buttonVariants({ variant: "outline" })}>Widget documentation<ArrowRight /></a>
        </div>
      </section>

      <section id="faq" class="scroll-mt-14 border-t bg-muted/40">
        <div class="mx-auto flex max-w-3xl flex-col gap-12 px-4 py-24">
          <div class="flex flex-col gap-4 text-center">
            <p class="flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground"><CircleHelp className="size-4" />Support</p>
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Frequently asked questions</h2>
          </div>
          <div class="divide-y rounded-xl bg-card ring-1 ring-border">
            {questions.map(({ question, answer }) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center gap-4 px-4 py-4 font-medium outline-none focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
                  {question}
                  <ChevronDown className="ml-auto size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
                </summary>
                <p class="px-4 pb-4 text-pretty text-muted-foreground">{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="download" class="scroll-mt-14 border-t">
        <div class="mx-auto flex max-w-5xl flex-col gap-12 px-4 py-24">
          <div class="mx-auto flex max-w-2xl flex-col gap-4 text-center">
            <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Download Toolblox</h2>
            <div data-downloads hidden class="flex flex-col items-center">
              <span data-downloads-count class="text-5xl font-semibold tracking-tight tabular-nums"></span>
              <span class="text-sm text-muted-foreground">downloads, not counting updates</span>
            </div>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <Card>
              <CardHeader>
                <Monitor className="mb-2 size-6" />
                <CardTitle>Windows</CardTitle>
                <CardDescription>For Windows 10 and 11<span data-release-version hidden></span></CardDescription>
              </CardHeader>
              <CardContent>
                <ol class="flex list-decimal flex-col gap-1 pl-5 text-sm text-muted-foreground">
                  <li>Open <strong class="font-medium text-foreground">Toolblox-Setup.exe</strong> once the download completes.</li>
                  <li>If Windows shows “Windows protected your PC”, select <strong class="font-medium text-foreground">More info</strong>, then <strong class="font-medium text-foreground">Run anyway</strong>.</li>
                  <li>Complete the setup. Toolblox updates automatically from then on.</li>
                </ol>
              </CardContent>
              <CardFooter className="mt-auto">
                <a href={installer} class={buttonVariants({ className: "w-full" })}><Download />Download for Windows</a>
              </CardFooter>
            </Card>
            <Card>
              <CardHeader>
                <Laptop className="mb-2 size-6" />
                <CardTitle>macOS</CardTitle>
                <CardDescription>For Apple silicon and Intel Macs<span data-mac-release-version hidden></span></CardDescription>
              </CardHeader>
              <CardContent>
                <ol class="flex list-decimal flex-col gap-1 pl-5 text-sm text-muted-foreground">
                  <li>Open <strong class="font-medium text-foreground">Toolblox.dmg</strong> and drag Toolblox to Applications.</li>
                  <li>If macOS says it can't verify the developer, select <strong class="font-medium text-foreground">Done</strong>, then <strong class="font-medium text-foreground">Open Anyway</strong> in System Settings → Privacy &amp; Security.</li>
                  <li>Toolblox updates automatically from then on.</li>
                </ol>
              </CardContent>
              <CardFooter className="mt-auto">
                <a href={`${repo}/releases`} data-mac-download data-href={macInstaller} data-ready-class={buttonVariants({ className: "w-full" })} class={buttonVariants({ variant: "outline", className: "w-full" })}><span data-mac-download-label>Coming in the next release</span></a>
              </CardFooter>
            </Card>
          </div>
          <p class="text-center text-sm text-pretty text-muted-foreground">
            Download Toolblox only from this site or its official GitHub page.{" "}
            <a href="/security/#verify-a-download" class="underline underline-offset-4">How to verify a download</a>
          </p>
        </div>
      </section>
  <script>
      fetch("https://api.github.com/repos/BakedAleska/Toolblox/releases?per_page=100")
        .then((response) => (response.ok ? response.json() : Promise.reject()))
        .then((releases: { tag_name: string; draft: boolean; assets: { name: string; download_count: number }[] }[]) => {
          const latest = releases.find((release) => !release.draft);
          if (latest) {
            const version = ` · Version ${latest.tag_name.replace(/^v/, "").replace("-", " ")}`;
            for (const element of document.querySelectorAll<HTMLElement>("[data-release-version]")) {
              element.textContent = version;
              element.hidden = false;
            }
            if (latest.assets.some((asset) => asset.name === "Toolblox.dmg")) {
              const link = document.querySelector<HTMLAnchorElement>("[data-mac-download]");
              const label = document.querySelector<HTMLElement>("[data-mac-download-label]");
              const macVersion = document.querySelector<HTMLElement>("[data-mac-release-version]");
              if (link?.dataset.href && label) {
                link.href = link.dataset.href;
                link.className = link.dataset.readyClass ?? link.className;
                label.textContent = "Download for macOS";
                label.insertAdjacentHTML("beforebegin", document.querySelector("[data-hero-download] svg")?.outerHTML ?? "");
              }
              if (macVersion) {
                macVersion.textContent = version;
                macVersion.hidden = false;
              }
              const hero = document.querySelector<HTMLAnchorElement>("[data-hero-download]");
              const heroLabel = document.querySelector<HTMLElement>("[data-hero-download-label]");
              if (hero && heroLabel && link?.dataset.href && /Macintosh/.test(navigator.userAgent)) {
                hero.href = link.dataset.href;
                heroLabel.textContent = "Download for macOS";
              }
            }
          }
          const total = releases
            .flatMap((release) => {
              const counted = release.assets.some((asset) => asset.name === "Toolblox-Update.exe") ? ["Toolblox-Setup.exe", "Toolblox.dmg"] : ["Toolblox.dmg"];
              return release.assets.filter((asset) => counted.includes(asset.name));
            })
            .reduce((sum, asset) => sum + asset.download_count, 0);
          if (!total) return;
          for (const element of document.querySelectorAll<HTMLElement>("[data-downloads-count]")) element.textContent = total.toLocaleString("en-US");
          for (const element of document.querySelectorAll<HTMLElement>("[data-downloads]")) element.hidden = false;
        })
        .catch(() => {});
  </script>
</Site>
