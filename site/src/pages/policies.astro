---
/** The former address of the Legal page. Links from Toolblox 0.3.0 and earlier point here, so the
 * section in the URL fragment is kept. `#legal` now maps to `#license`. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/legal/" />
    <title>Legal · Toolblox</title>
    <script is:inline>location.replace(`/legal/${location.hash === "#legal" ? "#license" : location.hash}`);</script>
    <noscript><meta http-equiv="refresh" content="0; url=/legal/" /></noscript>
  </head>
  <body><a href="/legal/">Legal</a></body>
</html>
