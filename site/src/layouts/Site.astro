---
import "../styles/global.css";
import GitHubIcon from "../components/GitHubIcon.astro";
import { buttonVariants } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { CircleAlert, Monitor, Moon, Star, Sun } from "lucide-react";

/** The page shell shared by the home page and the policy pages: header, footer, and theme. */
interface Props {
  title?: string;
  description?: string;
}

const { title, description = "A free, open-source Roblox account manager. No injection, and your data stays on your device." } = Astro.props;
const repo = "https://github.com/BakedAleska/Toolblox";
const discord = "https://discord.gg/pxBhrjEJM";
---

<!doctype html>
<html lang="en" data-os="other">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Toolblox` : "Toolblox"}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <script is:inline>
      const platform = navigator.userAgentData?.platform || navigator.platform || "";
      const isMac = (/mac/i.test(platform) || /Macintosh/.test(navigator.userAgent)) && navigator.maxTouchPoints < 2;
      const isWindows = /win/i.test(platform) || /Windows/.test(navigator.userAgent);
      document.documentElement.dataset.os = isMac ? "mac" : isWindows ? "windows" : "other";
      const scheme = matchMedia("(prefers-color-scheme: dark)");
      const applyScheme = () => {
        let choice = "system";
        try { choice = localStorage.getItem("toolblox-theme") || "system"; } catch {}
        const dark = choice === "dark" || (choice === "system" && scheme.matches);
        document.documentElement.dataset.theme = choice;
        document.documentElement.classList.toggle("dark", dark);
        document.dispatchEvent(new CustomEvent("toolblox:scheme", { detail: dark }));
      };
      applyScheme();
      scheme.addEventListener("change", applyScheme);
      document.addEventListener("toolblox:theme", applyScheme);
    </script>
  </head>
  <body class="pb-14 sm:pb-10">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-background focus:px-3 focus:py-2">Skip to content</a>

    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
      <nav class="mx-auto flex h-14 max-w-5xl items-center gap-4 px-4" aria-label="Main">
        <a href="/" class="mr-auto flex items-center gap-2 font-semibold">
          <img src="/logo.svg" alt="" width="24" height="24" />
          Toolblox
        </a>
        <a href="/#commitments" class="hidden text-sm text-muted-foreground hover:text-foreground sm:inline">Commitments</a>
        <a href="/#widgets" class="hidden text-sm text-muted-foreground hover:text-foreground sm:inline">Widgets</a>
        <a href="/#faq" class="hidden text-sm text-muted-foreground hover:text-foreground sm:inline">FAQ</a>
        <a href="/#download" class="hidden text-sm text-muted-foreground hover:text-foreground sm:inline">Download</a>
        <button type="button" data-theme-toggle class={buttonVariants({ size: "icon-sm", variant: "ghost" })} aria-label="Theme: System" title="Theme: System">
          <Monitor className="hidden in-data-[theme=system]:block" aria-hidden="true" />
          <Sun className="hidden in-data-[theme=light]:block" aria-hidden="true" />
          <Moon className="hidden in-data-[theme=dark]:block" aria-hidden="true" />
        </button>
        <a href={repo} class={buttonVariants({ size: "sm", variant: "ghost" })} aria-label="Toolblox on GitHub"><GitHubIcon /><span data-stars hidden class="inline-flex items-center gap-1"><Star className="size-3.5" aria-hidden="true" /><span data-stars-count></span></span></a>
        <a href="/#download" class={buttonVariants({ size: "sm" })}>Download</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-8 text-center text-sm text-muted-foreground">
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Footer">
          <a href="/#download" class="hover:text-foreground">Download</a>
          <a href="/docs/" class="hover:text-foreground">Widget docs</a>
          <a href="/legal/" class="hover:text-foreground">Legal</a>
          <a href={repo} class="hover:text-foreground">Source code</a>
        </nav>
        <Separator />
        <p>Toolblox isn't affiliated with or endorsed by Roblox Corporation. Roblox is a trademark of Roblox Corporation.</p>
      </div>
    </footer>

    <aside class="fixed inset-x-0 bottom-0 z-40 border-t bg-background/90 backdrop-blur" aria-label="Payment warning">
      <p class="mx-auto flex max-w-5xl items-center justify-center gap-2 px-4 py-2 text-center text-xs text-muted-foreground sm:text-sm">
        <CircleAlert className="size-4 shrink-0" aria-hidden="true" />
        <span>Toolblox is free and open source. If anyone asks you to pay for it, <a href={discord} class="font-medium text-foreground underline underline-offset-4">report it</a>.</span>
      </p>
    </aside>

    <script>
      const themes = ["system", "light", "dark"];
      const themeLabels: Record<string, string> = { system: "System", light: "Light", dark: "Dark" };
      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const labelTheme = () => {
        const label = `Theme: ${themeLabels[document.documentElement.dataset.theme || "system"]}`;
        themeToggle?.setAttribute("aria-label", label);
        themeToggle?.setAttribute("title", label);
      };
      labelTheme();
      themeToggle?.addEventListener("click", () => {
        const next = themes[(themes.indexOf(document.documentElement.dataset.theme || "system") + 1) % themes.length];
        try { localStorage.setItem("toolblox-theme", next); } catch {}
        document.documentElement.dataset.theme = next;
        document.dispatchEvent(new Event("toolblox:theme"));
        labelTheme();
      });

      fetch("https://api.github.com/repos/BakedAleska/Toolblox")
        .then((response) => (response.ok ? response.json() : Promise.reject()))
        .then(({ stargazers_count: stars }: { stargazers_count: number }) => {
          const element = document.querySelector<HTMLElement>("[data-stars]");
          const count = document.querySelector<HTMLElement>("[data-stars-count]");
          if (!stars || !element || !count) return;
          count.textContent = stars.toLocaleString("en-US");
          element.hidden = false;
          element.parentElement?.setAttribute("aria-label", `Toolblox on GitHub, ${count.textContent} ${stars === 1 ? "star" : "stars"}`);
        })
        .catch(() => {});
    </script>
  </body>
</html>
